name: 02-privileged
on:
  workflow_run:
    workflows: ["01-issue-triage"]
    types: [completed]
permissions:
  contents: write
  id-token: write
jobs:
  deploy:
    runs-on: ubuntu-latest
    if: ${{ github.event.workflow_run.conclusion == 'success' }}
    steps:
      - uses: actions/checkout@v4
      - name: Ação sensível simulada
        run: |
          echo "Aqui o job teria write access real"
          echo "Token disponível: ${{ secrets.FAKE_TOKEN }}"
